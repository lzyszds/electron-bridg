{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true
  },
  "include": [
    "electron.vite.config.ts",
    "electron/main/**/*.ts",
    "electron/preload/**/*.ts",
    "electron/shared/**/*.ts",
    // preload 会把 webview 用的桥接 SDK 源码直接内联进单文件产物，必须纳入编译范围
    "src/bridge/sdk.ts"
  ]
}
